# 复制本文件为 .env 后再按需修改（.env 不会提交到 Git）
# 命令：Copy-Item .env.example .env

APP_NAME=AI Study Assistant API
APP_VERSION=0.1.0
DEBUG=true

# 允许跨域访问的前端地址，必须是 JSON 数组格式
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# SQLite 数据库地址（相对于启动目录 backend/）。当前只做规划，没有建表。
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---------------- AI（大模型）配置 ----------------
# 走 OpenAI 兼容接口，换服务商只需要改下面三项，代码不用动。
# 常见的 base_url：
#   OpenAI   https://api.openai.com/v1
#   DeepSeek https://api.deepseek.com/v1
#   通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama http://127.0.0.1:11434/v1  （此时 api_key 随便填一个非空值即可）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 单次调用模型的超时时间（秒）
AI_TIMEOUT=60
